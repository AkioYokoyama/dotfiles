{
    "languageserver": {
        "intelephense": {
            "command": "intelephense",
            "args": ["--stdio"],
            "filetypes": ["php"],
            "initializationOptions": {
                "storagePath": "/tmp/intelephense"
            }
        },
        "rubocop": {
            "command": "rubocop",
            "args": ["--lsp"],
            "filetypes": ["ruby"]
        }
    },
    "diagnostic.checkers": {
        "ruby": {
            "command": "ruby",
            "args": ["-c", "%file%"]
        }
    }
}
